{
  "description": "Comprehensive thesis experiment suite for isolating fault impacts",
  "purpose": "Compare baseline vs individual fault types vs combined faults",
  "recommended_runs_per_config": 3,
  "total_duration_estimate": "~24 hours for full suite (3 runs each)",
  
  "experiments": {
    "baseline": {
      "name": "Baseline (No Faults)",
      "description": "Perfect conditions - establish performance baseline",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.0,
        "crash_duration_s": 0,
        "loss_pct": 0,
        "latency_ms": 0,
        "bandwidth_mbit": 100,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    },
    
    "crash_only": {
      "name": "Crash Faults Only",
      "description": "30% node crashes without network impairments",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.30,
        "crash_duration_s": 300,
        "crash_mode": "burst",
        "recovery_mode": "cold",
        "loss_pct": 0,
        "latency_ms": 0,
        "bandwidth_mbit": 100,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    },
    
    "network_only": {
      "name": "Network Faults Only (Omission)",
      "description": "Packet loss and latency without crashes",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.0,
        "crash_duration_s": 0,
        "loss_pct": 2,
        "latency_ms": 100,
        "bandwidth_mbit": 10,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    },
    
    "combined": {
      "name": "Combined Faults (Crash + Network)",
      "description": "30% crashes with realistic network conditions - worst case",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.30,
        "crash_duration_s": 300,
        "crash_mode": "burst",
        "recovery_mode": "cold",
        "loss_pct": 2,
        "latency_ms": 100,
        "bandwidth_mbit": 10,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    },
    
    "high_crash": {
      "name": "High Crash Fraction (50%)",
      "description": "Test system limits - maximum crash tolerance",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.50,
        "crash_duration_s": 300,
        "crash_mode": "burst",
        "recovery_mode": "cold",
        "loss_pct": 2,
        "latency_ms": 100,
        "bandwidth_mbit": 10,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    },
    
    "staggered_crash": {
      "name": "Staggered Crash Pattern",
      "description": "Compare burst vs gradual failures",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.30,
        "crash_duration_s": 300,
        "crash_mode": "staggered",
        "recovery_mode": "cold",
        "loss_pct": 2,
        "latency_ms": 100,
        "bandwidth_mbit": 10,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    },
    
    "fast_recovery": {
      "name": "Fast Recovery Mode",
      "description": "Compare cold vs fast recovery overhead",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.30,
        "crash_duration_s": 300,
        "crash_mode": "burst",
        "recovery_mode": "fast",
        "reindex_on_restart": false,
        "loss_pct": 2,
        "latency_ms": 100,
        "bandwidth_mbit": 10,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    },
    
    "severe_network": {
      "name": "Severe Network Conditions",
      "description": "Test under aggressive network impairments",
      "config": {
        "node_count": 32,
        "tx_rate": 10,
        "crash_fraction": 0.30,
        "crash_duration_s": 300,
        "crash_mode": "burst",
        "recovery_mode": "cold",
        "loss_pct": 5,
        "latency_ms": 200,
        "bandwidth_mbit": 5,
        "warmup_s": 180,
        "observe_s": 1800,
        "cooldown_s": 60,
        "seed": 42
      }
    }
  },
  
  "analysis_comparisons": [
    {
      "name": "Crash Impact Isolation",
      "compare": ["baseline", "crash_only"],
      "metrics": ["confirmation_latency", "throughput", "availability"],
      "hypothesis": "Crash faults increase latency by X% and reduce throughput by Y%"
    },
    {
      "name": "Network Impact Isolation",
      "compare": ["baseline", "network_only"],
      "metrics": ["confirmation_latency", "throughput", "availability"],
      "hypothesis": "Network faults increase latency by X% and reduce throughput by Y%"
    },
    {
      "name": "Compound Effect Analysis",
      "compare": ["crash_only", "network_only", "combined"],
      "metrics": ["confirmation_latency", "throughput", "recovery_time"],
      "hypothesis": "Combined faults have non-additive (synergistic) effects"
    },
    {
      "name": "Recovery Mode Comparison",
      "compare": ["combined", "fast_recovery"],
      "metrics": ["recovery_time", "confirmation_latency"],
      "hypothesis": "Cold recovery adds significant overhead vs fast recovery"
    },
    {
      "name": "Crash Pattern Comparison",
      "compare": ["combined", "staggered_crash"],
      "metrics": ["peak_latency", "recovery_smoothness"],
      "hypothesis": "Burst crashes cause sharper performance degradation than staggered"
    }
  ]
}

