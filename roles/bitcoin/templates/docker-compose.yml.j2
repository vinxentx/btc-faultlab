name: "{{ network_name }}"

{% set n = (node_count | int) %}
{% set core_size = 8 if n >= 8 else n %}
{#
   NETWORK TOPOLOGY - Generated by topology_generator.py

   Modes (set via topology_mode variable):
   - hierarchical: 3-tier (Core mesh + Secondary + Outer round-robin)
   - hybrid: Core mesh + non-core k-regular random graph (more realistic)

   Core (8 nodes): Full mesh simulating mining pool clique
   Non-core: Topology depends on mode, generated externally

   CRITICAL: -discover=0 for deterministic, reproducible topology!
#}
services:
{% for i in range(1, n + 1) %}
  node{{ "%02d"|format(i) }}:
    image: "{{ image }}"
    container_name: "node{{ "%02d"|format(i) }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=0"
      - "-dnsseed=0"
      - "-listen=1"
{# Peer connections from pre-generated network_topology #}
{% set node_peers = network_topology[i | string] | default([]) %}
{% for peer_id in node_peers %}
      - "-connect=node{{ '%02d'|format(peer_id) }}:18444"
{% endfor %}
    volumes:
      - "node{{ '%02d'|format(i) }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/node{{ '%02d'|format(i) }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ 20443 + (i - 1) * 4 }}:18443"
      - "{{ 20444 + (i - 1) * 4 }}:18444"
      - "{{ 30332 + (i - 1) * 4 }}:28332"
      - "{{ 30333 + (i - 1) * 4 }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
{% endfor %}

{% set wallet_base_rpc = 21043 %}
{% set wallet_base_p2p = 21044 %}
{% set wallet_base_zmq_block = 31032 %}
{% set wallet_base_zmq_tx = 31033 %}

  {{ wallet_funding_container }}:
    image: "{{ image }}"
    container_name: "{{ wallet_funding_container }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=0"
      - "-dnsseed=0"
      - "-listen=1"
{% if core_size > 0 %}
      # Connect to ALL core nodes for maximum redundancy and fast block propagation
      # This ensures the funding wallet sees all blocks immediately
{% for j in range(1, core_size + 1) %}
      - "-connect=node{{ '%02d'|format(j) }}:18444"
{% endfor %}
{% endif %}
    volumes:
      - "{{ wallet_funding_container }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/{{ wallet_funding_container }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ wallet_base_rpc }}:18443"
      - "{{ wallet_base_p2p }}:18444"
      - "{{ wallet_base_zmq_block }}:28332"
      - "{{ wallet_base_zmq_tx }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

{% for shard in txgen_shards %}
{% set offset = (loop.index) * 10 %}
  {{ shard.wallet_container }}:
    image: "{{ image }}"
    container_name: "{{ shard.wallet_container }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command:
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=32"
      - "-discover=0"
      - "-dnsseed=0"
      - "-listen=1"
      # Connect directly to ALL core nodes for fast propagation
      # wallet_shard nodes are implicitly excluded from netem (different naming pattern)
{% if core_size > 0 %}
{% for j in range(1, core_size + 1) %}
      - "-connect=node{{ '%02d'|format(j) }}:18444"
{% endfor %}
{% endif %}
    volumes:
      - "{{ shard.wallet_container }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/{{ shard.wallet_container }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ wallet_base_rpc + offset }}:18443"
      - "{{ wallet_base_p2p + offset }}:18444"
      - "{{ wallet_base_zmq_block + offset }}:28332"
      - "{{ wallet_base_zmq_tx + offset }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
{% endfor %}

{% set shard_count = txgen_shards | length %}
{% if shard_count > 0 %}
{% set shard_rate = (tx_rate | float) / shard_count %}
{% for shard in txgen_shards %}
  txgen_{{ shard.id }}:
    image: "python:3.12-slim"
    container_name: "txgen_{{ shard.id }}"
    restart: unless-stopped
    user: "0:0"
    working_dir: /app
    volumes:
      - "{{ workdir }}/files:/app:ro"
      - "txlogs_{{ shard.log_suffix }}:/results"
      - "{{ workdir }}/state:/state:ro"
    command:
      - python
      - -u
      - /app/txgen.py
      - --shard-id
      - "{{ shard.id }}"
      - --rate
      - "{{ '%.4f'|format(shard_rate) }}"
      - --rpc
      - "http://{{ rpc_user }}:{{ rpc_pass }}@{{ shard.wallet_container }}:18443"
      - --wallet
      - "{{ shard.wallet_name }}"
      - --log
      - "/results/txlog_{{ shard.log_suffix }}.csv"
      - --node-count
      - "{{ node_count }}"
      - --address-pool-size
      - "{{ txgen_address_pool_size }}"
      - --address-reuse-window
      - "{{ txgen_address_reuse_window }}"
      - --amount-btc
      - "{{ txgen_send_amount_btc }}"
      - --utxo-target
      - "{{ wallet_descriptor_pool_size }}"
      - --num-workers
      - "{{ txgen_num_workers | default(4) }}"
      - --queue-size
      - "{{ txgen_queue_size | default(200) }}"
      - --max-duration
      # warmup + observe + cooldown + 90s setup buffer (netem, sync waits, etc.)
      - "{{ warmup_s + observe_s + cooldown_s + 90 }}"
    depends_on:
      {{ shard.wallet_container }}:
        condition: service_healthy
    networks: [ "{{ network_name }}" ]
    profiles:
      - txgen
{% endfor %}
{% endif %}

  block_scheduler:
    image: "python:3.12-slim"
    container_name: "block_scheduler"
    restart: unless-stopped
    user: "0:0"
    working_dir: /app
    volumes:
      - "{{ workdir }}/files:/app:ro"
      - "{{ workdir }}/state:/state:ro"
    command:
      - python
      - -u
      - /app/block_scheduler.py
      - --interval
      - "{{ block_scheduler_interval_s }}"
      - --node-count
      - "{{ node_count }}"
      - --mining-percentage
      - "{{ mining_percentage }}"
      - --rpc-user
      - "{{ rpc_user }}"
      - --rpc-pass
      - "{{ rpc_pass }}"
      - --seed
      - "{{ block_scheduler_seed }}"
      - --config
      - /state/mining_targets.json
{% if block_scheduler_use_variance | default(false) %}
      - --use-variance
{% endif %}
{% if block_scheduler_min_interval is defined and block_scheduler_min_interval is not none %}
      - --min-interval
      - "{{ block_scheduler_min_interval }}"
{% endif %}
{% if block_scheduler_adaptive_interval | default(true) %}
      - --adaptive-interval
{% endif %}
      - --health-check-interval
      - "{{ block_scheduler_health_check_interval | default(10.0) }}"
    depends_on:
      {{ wallet_funding_container }}:
        condition: service_healthy
    networks: [ "{{ network_name }}" ]

networks:
  {{ network_name }}:
    driver: bridge
volumes:
{% for i in range(1, n + 1) %}
  node{{ '%02d'|format(i) }}_data: {}
{% endfor %}
  {{ wallet_funding_container }}_data: {}
{% for shard in txgen_shards %}
  {{ shard.wallet_container }}_data: {}
  txlogs_{{ shard.log_suffix }}: {}
{% endfor %}

