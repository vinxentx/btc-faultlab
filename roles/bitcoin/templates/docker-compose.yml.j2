name: "{{ network_name }}"

{% set n = (node_count | int) %}
{% set core_size = 8 if n >= 8 else n %}
{% set secondary_size = ([n - core_size, 8] | min) if n > core_size else 0 %}
{% set outer_size = n - core_size - secondary_size %}
{% set core_nodes = range(1, core_size + 1) | list %}
{% set secondary_nodes = range(core_size + 1, core_size + secondary_size + 1) | list %}
{# 
   DETERMINISTISCHE NETZWERKTOPOLOGIE für wissenschaftliche Experimente
   
   Wissenschaftliche Grundlage:
   - "Miner-Clique dominiert Propagation" (2025): Mining-Pools bilden dicht 
     verbundenen Kern, Full-Nodes sind peripher
   - "Peer Selection affects Fork Rate" (2022): Gute Peer-Auswahl reduziert Forks
   - Echtes Bitcoin: Median 0.5s, p90 2.5s Block-Propagation
   
   Topologie-Design (Hub-and-Spoke):
   - Core (8 Nodes): Volles Mesh - simuliert Mining-Pool-Clique (7 Peers je)
   - Secondary (8 Nodes): Alle 8 Core + 2 Nachbarn = 10 Peers je
   - Outer (Rest): 2 Secondary-Nodes = 2 Peers je (max 3 Hops)
   
   KRITISCH: -discover=0 für deterministische, reproduzierbare Topologie!
   Gesamtverbindungen: 8*7/2 + 8*8 + 8*2/2 + 112*2 = 28 + 64 + 8 + 224 = 324
#}
services:
{% for i in range(1, n + 1) %}
  node{{ "%02d"|format(i) }}:
    image: "{{ image }}"
    container_name: "node{{ "%02d"|format(i) }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=0"
      - "-dnsseed=0"
      - "-listen=1"
{# Berechne Targets basierend auf Node-Tier #}
{% if i <= core_size %}
      # CORE TIER: Volles Mesh zu anderen Core-Nodes (simuliert Mining-Pool-Clique)
{% for j in core_nodes %}
{% if j > i %}
      - "-connect=node{{ '%02d'|format(j) }}:18444"
{% endif %}
{% endfor %}
{% elif i <= core_size + secondary_size %}
      # SECONDARY TIER: Verbindung zu ALLEN Core-Nodes + Ring-Nachbarn
{% for j in core_nodes %}
      - "-connect=node{{ '%02d'|format(j) }}:18444"
{% endfor %}
{% if i + 1 <= core_size + secondary_size %}
      - "-connect=node{{ '%02d'|format(i + 1) }}:18444"
{% endif %}
{% else %}
      # OUTER TIER: Verbindung zu 2 Secondary-Nodes (deterministisch Round-Robin)
      # Falls keine Secondary-Nodes existieren (n <= 8), verbinde direkt zu Core
{% if secondary_size > 0 %}
{% set base = i - core_size - secondary_size - 1 %}
{% set sec1 = core_size + (base % secondary_size) + 1 %}
{% set sec2 = core_size + ((base + 4) % secondary_size) + 1 %}
{% if sec1 != sec2 %}
      - "-connect=node{{ '%02d'|format(sec1) }}:18444"
      - "-connect=node{{ '%02d'|format(sec2) }}:18444"
{% else %}
      - "-connect=node{{ '%02d'|format(sec1) }}:18444"
      - "-connect=node{{ '%02d'|format((sec1 - core_size) % secondary_size + core_size + 1) }}:18444"
{% endif %}
{% else %}
      # Keine Secondary-Nodes, verbinde direkt zu Core-Nodes
{% for j in core_nodes[:2] %}
      - "-connect=node{{ '%02d'|format(j) }}:18444"
{% endfor %}
{% endif %}
{% endif %}
    volumes:
      - "node{{ '%02d'|format(i) }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/node{{ '%02d'|format(i) }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ 20443 + (i - 1) * 4 }}:18443"
      - "{{ 20444 + (i - 1) * 4 }}:18444"
      - "{{ 30332 + (i - 1) * 4 }}:28332"
      - "{{ 30333 + (i - 1) * 4 }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
{% endfor %}

{% set wallet_base_rpc = 21043 %}
{% set wallet_base_p2p = 21044 %}
{% set wallet_base_zmq_block = 31032 %}
{% set wallet_base_zmq_tx = 31033 %}

  {{ wallet_funding_container }}:
    image: "{{ image }}"
    container_name: "{{ wallet_funding_container }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=0"
      - "-dnsseed=0"
      - "-listen=1"
{% if core_size > 0 %}
      # Connect to ALL core nodes for maximum redundancy and fast block propagation
      # This ensures the funding wallet sees all blocks immediately
{% for j in range(1, core_size + 1) %}
      - "-connect=node{{ '%02d'|format(j) }}:18444"
{% endfor %}
{% endif %}
    volumes:
      - "{{ wallet_funding_container }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/{{ wallet_funding_container }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ wallet_base_rpc }}:18443"
      - "{{ wallet_base_p2p }}:18444"
      - "{{ wallet_base_zmq_block }}:28332"
      - "{{ wallet_base_zmq_tx }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

{% for shard in txgen_shards %}
{% set offset = (loop.index) * 10 %}
  {{ shard.wallet_container }}:
    image: "{{ image }}"
    container_name: "{{ shard.wallet_container }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command:
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=32"
      - "-discover=0"
      - "-dnsseed=0"
      - "-listen=1"
      # Connect directly to ALL core nodes for fast propagation
      # wallet_shard nodes are implicitly excluded from netem (different naming pattern)
{% if core_size > 0 %}
{% for j in range(1, core_size + 1) %}
      - "-connect=node{{ '%02d'|format(j) }}:18444"
{% endfor %}
{% endif %}
    volumes:
      - "{{ shard.wallet_container }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/{{ shard.wallet_container }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ wallet_base_rpc + offset }}:18443"
      - "{{ wallet_base_p2p + offset }}:18444"
      - "{{ wallet_base_zmq_block + offset }}:28332"
      - "{{ wallet_base_zmq_tx + offset }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
{% endfor %}

{% set shard_count = txgen_shards | length %}
{% if shard_count > 0 %}
{% set shard_rate = (tx_rate | float) / shard_count %}
{% for shard in txgen_shards %}
  txgen_{{ shard.id }}:
    image: "python:3.12-slim"
    container_name: "txgen_{{ shard.id }}"
    restart: unless-stopped
    user: "0:0"
    working_dir: /app
    volumes:
      - "{{ workdir }}/files:/app:ro"
      - "txlogs_{{ shard.log_suffix }}:/results"
      - "{{ workdir }}/state:/state:ro"
    command:
      - python
      - -u
      - /app/txgen.py
      - --shard-id
      - "{{ shard.id }}"
      - --rate
      - "{{ '%.4f'|format(shard_rate) }}"
      - --rpc
      - "http://{{ rpc_user }}:{{ rpc_pass }}@{{ shard.wallet_container }}:18443"
      - --wallet
      - "{{ shard.wallet_name }}"
      - --log
      - "/results/txlog_{{ shard.log_suffix }}.csv"
      - --node-count
      - "{{ node_count }}"
      - --address-pool-size
      - "{{ txgen_address_pool_size }}"
      - --address-reuse-window
      - "{{ txgen_address_reuse_window }}"
      - --amount-btc
      - "{{ txgen_send_amount_btc }}"
      - --utxo-target
      - "{{ wallet_descriptor_pool_size }}"
      - --num-workers
      - "{{ txgen_num_workers | default(4) }}"
      - --queue-size
      - "{{ txgen_queue_size | default(200) }}"
    depends_on:
      {{ shard.wallet_container }}:
        condition: service_healthy
    networks: [ "{{ network_name }}" ]
    profiles:
      - txgen
{% endfor %}
{% endif %}

  block_scheduler:
    image: "python:3.12-slim"
    container_name: "block_scheduler"
    restart: unless-stopped
    user: "0:0"
    working_dir: /app
    volumes:
      - "{{ workdir }}/files:/app:ro"
      - "{{ workdir }}/state:/state:ro"
    command:
      - python
      - -u
      - /app/block_scheduler.py
      - --interval
      - "{{ block_scheduler_interval_s }}"
      - --node-count
      - "{{ node_count }}"
      - --mining-percentage
      - "{{ mining_percentage }}"
      - --rpc-user
      - "{{ rpc_user }}"
      - --rpc-pass
      - "{{ rpc_pass }}"
      - --seed
      - "{{ block_scheduler_seed }}"
      - --config
      - /state/mining_targets.json
{% if block_scheduler_use_variance | default(false) %}
      - --use-variance
{% endif %}
{% if block_scheduler_min_interval is defined and block_scheduler_min_interval is not none %}
      - --min-interval
      - "{{ block_scheduler_min_interval }}"
{% endif %}
{% if block_scheduler_adaptive_interval | default(true) %}
      - --adaptive-interval
{% endif %}
      - --health-check-interval
      - "{{ block_scheduler_health_check_interval | default(10.0) }}"
    depends_on:
      {{ wallet_funding_container }}:
        condition: service_healthy
    networks: [ "{{ network_name }}" ]

networks:
  {{ network_name }}:
    driver: bridge
volumes:
{% for i in range(1, n + 1) %}
  node{{ '%02d'|format(i) }}_data: {}
{% endfor %}
  {{ wallet_funding_container }}_data: {}
{% for shard in txgen_shards %}
  {{ shard.wallet_container }}_data: {}
  txlogs_{{ shard.log_suffix }}: {}
{% endfor %}

