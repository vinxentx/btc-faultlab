name: "{{ network_name }}"

{% set n = (node_count | int) %}
{% set core_size = 8 if n >= 8 else n %}
{% set secondary_size = ([n - core_size, 8] | min) if n > core_size else 0 %}
{% set outer_size = n - core_size - secondary_size %}
{% set core_nodes = range(1, core_size + 1) %}
{% set secondary_nodes = range(core_size + 1, core_size + secondary_size + 1) %}
services:
{% for i in range(1, n + 1) %}
  node{{ "%02d"|format(i) }}:
    image: "{{ image }}"
    container_name: "node{{ "%02d"|format(i) }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=1"
      - "-dnsseed=0"
      - "-listen=1"
{% set targets = [] %}
{% if i <= core_size %}
      # Core tier - dense mesh with spillover
{% for j in core_nodes %}
{% if j != i %}
{% set targets = targets + [j] %}
{% endif %}
{% endfor %}
{% if secondary_size > 0 %}
{% set secondary_peer = core_size + ((i - 1) % secondary_size) + 1 %}
{% set targets = targets + [secondary_peer] %}
{% endif %}
{% elif i <= core_size + secondary_size %}
      # Secondary tier - connect to rotating core subset and neighbors
{% set base = i - core_size - 1 %}
{% for offset in range(0, [4, core_size] | min) %}
{% set core_idx = ((base + offset) % core_size) + 1 %}
{% set targets = targets + [core_idx] %}
{% endfor %}
{% if i - 1 >= core_size + 1 %}
{% set targets = targets + [i - 1] %}
{% endif %}
{% if i + 1 <= core_size + secondary_size %}
{% set targets = targets + [i + 1] %}
{% endif %}
{% if outer_size > 0 %}
{% set outer_peer = core_size + secondary_size + ((base) % outer_size) + 1 %}
{% set targets = targets + [outer_peer] %}
{% endif %}
{% else %}
      # Outer tier - mix of core, secondary, and lateral links
{% set base = i - core_size - secondary_size - 1 %}
{% if core_size > 0 %}
{% for offset in [0, 2, 4] %}
{% if offset < core_size %}
{% set core_idx = ((base + offset) % core_size) + 1 %}
{% set targets = targets + [core_idx] %}
{% endif %}
{% endfor %}
{% endif %}
{% if secondary_size > 0 %}
{% for offset in range(0, [2, secondary_size] | min) %}
{% set secondary_idx = core_size + ((base + offset) % secondary_size) + 1 %}
{% set targets = targets + [secondary_idx] %}
{% endfor %}
{% endif %}
{% if i - 1 >= core_size + secondary_size + 1 %}
{% set targets = targets + [i - 1] %}
{% endif %}
{% if i + 1 <= n %}
{% set targets = targets + [i + 1] %}
{% endif %}
{% endif %}
{% for target in targets | unique | list | sort %}
{% if target != i %}
      - "-connect=node{{ '%02d'|format(target) }}:18444"
{% endif %}
{% endfor %}
    volumes:
      - "node{{ '%02d'|format(i) }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/node{{ '%02d'|format(i) }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ 20443 + (i - 1) * 4 }}:18443"
      - "{{ 20444 + (i - 1) * 4 }}:18444"
      - "{{ 30332 + (i - 1) * 4 }}:28332"
      - "{{ 30333 + (i - 1) * 4 }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
{% endfor %}

  wallet:
    image: "{{ image }}"
    container_name: "wallet"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=1"
      - "-dnsseed=0"
      - "-listen=1"
{% if core_size > 0 %}
      # Connect to multiple core nodes for redundancy (backup peers)
      # Connect to first 10 core nodes (or all if fewer than 10)
{% set wallet_peers = [core_size, 10] | min %}
{% for i in range(1, wallet_peers + 1) %}
      - "-connect=node{{ '%02d'|format(i) }}:18444"
{% endfor %}
{% endif %}
    volumes:
      - "wallet_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/wallet/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "21043:18443"
      - "21044:18444"
      - "31032:28332"
      - "31033:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  txgen:
    image: "python:3.12-slim"
    container_name: "txgen"
    restart: unless-stopped
    user: "0:0"
    working_dir: /app
    volumes:
      - "{{ workdir }}/files:/app:ro"
      - "txlogs:/results"
    command: >
      bash -lc "pip install requests && python -u /app/txgen.py --rate {{ tx_rate }}
      --rpc http://{{ rpc_user }}:{{ rpc_pass }}@wallet:18443
      --log /results/txlog.csv
      --node-count {{ node_count }}
      --mining-percentage 0.08"
    depends_on:
      wallet:
        condition: service_healthy
    networks: [ "{{ network_name }}" ]
    healthcheck:
      test: ["CMD", "python", "-c", "import requests; requests.get('http://{{ rpc_user }}:{{ rpc_pass }}@wallet:18443', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

networks:
  {{ network_name }}:
    driver: bridge
volumes:
{% for i in range(1, n + 1) %}
  node{{ '%02d'|format(i) }}_data: {}
{% endfor %}
  wallet_data: {}
  txlogs: {}
