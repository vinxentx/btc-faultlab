name: "{{ network_name }}"

{% set n = (node_count | int) %}
{% set core_size = 8 if n >= 8 else n %}
{% set secondary_size = ([n - core_size, 8] | min) if n > core_size else 0 %}
{% set outer_size = n - core_size - secondary_size %}
{% set core_nodes = range(1, core_size + 1) %}
{% set secondary_nodes = range(core_size + 1, core_size + secondary_size + 1) %}
services:
{% for i in range(1, n + 1) %}
  node{{ "%02d"|format(i) }}:
    image: "{{ image }}"
    container_name: "node{{ "%02d"|format(i) }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=1"
      - "-dnsseed=0"
      - "-listen=1"
{% set targets = [] %}
{% if i <= core_size %}
      # Core tier - dense mesh with spillover
{% for j in core_nodes %}
{% if j != i %}
{% set targets = targets + [j] %}
{% endif %}
{% endfor %}
{% if secondary_size > 0 %}
{% set secondary_peer = core_size + ((i - 1) % secondary_size) + 1 %}
{% set targets = targets + [secondary_peer] %}
{% endif %}
{% elif i <= core_size + secondary_size %}
      # Secondary tier - connect to rotating core subset and neighbors
{% set base = i - core_size - 1 %}
{% for offset in range(0, [4, core_size] | min) %}
{% set core_idx = ((base + offset) % core_size) + 1 %}
{% set targets = targets + [core_idx] %}
{% endfor %}
{% if i - 1 >= core_size + 1 %}
{% set targets = targets + [i - 1] %}
{% endif %}
{% if i + 1 <= core_size + secondary_size %}
{% set targets = targets + [i + 1] %}
{% endif %}
{% if outer_size > 0 %}
{% set outer_peer = core_size + secondary_size + ((base) % outer_size) + 1 %}
{% set targets = targets + [outer_peer] %}
{% endif %}
{% else %}
      # Outer tier - mix of core, secondary, and lateral links
{% set base = i - core_size - secondary_size - 1 %}
{% if core_size > 0 %}
{% for offset in [0, 2, 4] %}
{% if offset < core_size %}
{% set core_idx = ((base + offset) % core_size) + 1 %}
{% set targets = targets + [core_idx] %}
{% endif %}
{% endfor %}
{% endif %}
{% if secondary_size > 0 %}
{% for offset in range(0, [2, secondary_size] | min) %}
{% set secondary_idx = core_size + ((base + offset) % secondary_size) + 1 %}
{% set targets = targets + [secondary_idx] %}
{% endfor %}
{% endif %}
{% if i - 1 >= core_size + secondary_size + 1 %}
{% set targets = targets + [i - 1] %}
{% endif %}
{% if i + 1 <= n %}
{% set targets = targets + [i + 1] %}
{% endif %}
{% endif %}
{% for target in targets | unique | list | sort %}
{% if target != i %}
      - "-connect=node{{ '%02d'|format(target) }}:18444"
{% endif %}
{% endfor %}
    volumes:
      - "node{{ '%02d'|format(i) }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/node{{ '%02d'|format(i) }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ 20443 + (i - 1) * 4 }}:18443"
      - "{{ 20444 + (i - 1) * 4 }}:18444"
      - "{{ 30332 + (i - 1) * 4 }}:28332"
      - "{{ 30333 + (i - 1) * 4 }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
{% endfor %}

{% set wallet_base_rpc = 21043 %}
{% set wallet_base_p2p = 21044 %}
{% set wallet_base_zmq_block = 31032 %}
{% set wallet_base_zmq_tx = 31033 %}

  {{ wallet_funding_container }}:
    image: "{{ image }}"
    container_name: "{{ wallet_funding_container }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command: 
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=64"
      - "-discover=1"
      - "-dnsseed=0"
      - "-listen=1"
{% if core_size > 0 %}
      # Connect to multiple core nodes for redundancy (backup peers)
      # Connect to first 10 core nodes (or all if fewer than 10)
{% set wallet_peers = [core_size, 10] | min %}
{% for i in range(1, wallet_peers + 1) %}
      - "-connect=node{{ '%02d'|format(i) }}:18444"
{% endfor %}
{% endif %}
    volumes:
      - "{{ wallet_funding_container }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/{{ wallet_funding_container }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ wallet_base_rpc }}:18443"
      - "{{ wallet_base_p2p }}:18444"
      - "{{ wallet_base_zmq_block }}:28332"
      - "{{ wallet_base_zmq_tx }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

{% for shard in txgen_shards %}
{% set offset = (loop.index) * 10 %}
  {{ shard.wallet_container }}:
    image: "{{ image }}"
    container_name: "{{ shard.wallet_container }}"
    restart: unless-stopped
    user: "101:101"
    entrypoint: ["bitcoind"]
    command:
      - "-regtest=1"
      - "-printtoconsole=1"
      - "-datadir=/home/bitcoin/.bitcoin"
      - "-server=1"
      - "-txindex=1"
      - "-rpcuser={{ rpc_user }}"
      - "-rpcpassword={{ rpc_pass }}"
      - "-rpcbind=0.0.0.0"
      - "-rpcallowip=0.0.0.0/0"
      - "-zmqpubhashblock=tcp://0.0.0.0:28332"
      - "-zmqpubhashtx=tcp://0.0.0.0:28333"
      - "-maxconnections=32"
      - "-discover=1"
      - "-dnsseed=0"
      - "-listen=1"
{% if core_size > 0 %}
      # Verbinde jeden Shard mit zwei Kernknoten für geringe Latenz
{% for peer in range(1, ([core_size, 3] | min) + 1) %}
      - "-connect=node{{ '%02d'|format(peer) }}:18444"
{% endfor %}
{% endif %}
    volumes:
      - "{{ shard.wallet_container }}_data:/home/bitcoin/.bitcoin"
      - "{{ workdir }}/config/{{ shard.wallet_container }}/bitcoin.conf:/home/bitcoin/.bitcoin/bitcoin.conf:ro"
    networks: [ "{{ network_name }}" ]
    ports:
      - "{{ wallet_base_rpc + offset }}:18443"
      - "{{ wallet_base_p2p + offset }}:18444"
      - "{{ wallet_base_zmq_block + offset }}:28332"
      - "{{ wallet_base_zmq_tx + offset }}:28333"
    healthcheck:
      test: ["CMD", "bitcoin-cli", "-regtest", "getblockchaininfo"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
{% endfor %}

{% set shard_count = txgen_shards | length %}
{% if shard_count > 0 %}
{% set shard_rate = (tx_rate | float) / shard_count %}
{% for shard in txgen_shards %}
  txgen_{{ shard.id }}:
    image: "python:3.12-slim"
    container_name: "txgen_{{ shard.id }}"
    restart: unless-stopped
    user: "0:0"
    working_dir: /app
    volumes:
      - "{{ workdir }}/files:/app:ro"
      - "txlogs_{{ shard.log_suffix }}:/results"
    command:
      - python
      - -u
      - /app/txgen.py
      - --shard-id
      - "{{ shard.id }}"
      - --rate
      - "{{ '%.4f'|format(shard_rate) }}"
      - --rpc
      - "http://{{ rpc_user }}:{{ rpc_pass }}@{{ shard.wallet_container }}:18443"
      - --wallet
      - "{{ shard.wallet_name }}"
      - --log
      - "/results/txlog_{{ shard.log_suffix }}.csv"
      - --node-count
      - "{{ node_count }}"
      - --address-pool-size
      - "{{ txgen_address_pool_size }}"
      - --address-reuse-window
      - "{{ txgen_address_reuse_window }}"
      - --amount-btc
      - "{{ txgen_send_amount_btc }}"
      - --utxo-target
      - "{{ wallet_descriptor_pool_size }}"
    depends_on:
      {{ shard.wallet_container }}:
        condition: service_healthy
    networks: [ "{{ network_name }}" ]
{% endfor %}
{% endif %}

  block_scheduler:
    image: "python:3.12-slim"
    container_name: "block_scheduler"
    restart: unless-stopped
    user: "0:0"
    working_dir: /app
    volumes:
      - "{{ workdir }}/files:/app:ro"
      - "{{ workdir }}/state:/state:ro"
    command:
      - python
      - -u
      - /app/block_scheduler.py
      - --interval
      - "{{ block_scheduler_interval_s }}"
      - --node-count
      - "{{ node_count }}"
      - --mining-percentage
      - "{{ mining_percentage }}"
      - --rpc-user
      - "{{ rpc_user }}"
      - --rpc-pass
      - "{{ rpc_pass }}"
      - --seed
      - "{{ block_scheduler_seed }}"
      - --config
      - /state/mining_targets.json
    depends_on:
      {{ wallet_funding_container }}:
        condition: service_healthy
    networks: [ "{{ network_name }}" ]

networks:
  {{ network_name }}:
    driver: bridge
volumes:
{% for i in range(1, n + 1) %}
  node{{ '%02d'|format(i) }}_data: {}
{% endfor %}
  {{ wallet_funding_container }}_data: {}
{% for shard in txgen_shards %}
  {{ shard.wallet_container }}_data: {}
  txlogs_{{ shard.log_suffix }}: {}
{% endfor %}
